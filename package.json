{
  "name": "billium",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Offline-first invoicing and quotation app for freelancers and small businesses. Supports Electron desktop and self-hosted web modes.",
  "author": "Billium <contact@billium.app>",
  "keywords": [
    "invoice",
    "quotation",
    "quote",
    "billing",
    "pdf-export",
    "pdf-generation",
    "business-management",
    "finance",
    "desktop-app",
    "electron",
    "local-database",
    "e-invoices",
    "peppol",
    "ubl"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "npm run dev:clean:backend && concurrently \"npm:dev:react\" \"npm:dev:preload\" \"npm:dev:migrations\" \"npm:dev:electron\" \"npm:dev:electron:start:wait\"",
    "dev:clean:backend": "rimraf dist-be/backend",
    "dev:webserver": "npx tsx --watch src/backend/webserver/main.ts",
    "dev:fe": "concurrently \"npm:dev:react\" \"npm:dev:preload\" \"npm:dev:migrations\"",
    "dev:preload": "vite build --config vite.preload.config.ts --watch",
    "dev:react": "vite",
    "dev:electron": "vite build --config vite.main.config.ts --watch",
    "dev:electron:start:wait": "wait-on dist-be/backend/main/main.cjs && electron .",
    "dev:migrations": "vite build --config vite.migrations.config.ts --watch",
    "build": "vite build && vite build --config vite.preload.config.ts && vite build --config vite.main.config.ts && vite build --config vite.migrations.config.ts",
    "build:webserver": "vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "main": "dist-be/backend/main/main.cjs",
  "dependencies": {
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@mui/icons-material": "^6.4.0",
    "@mui/material": "^6.4.0",
    "@reduxjs/toolkit": "^2.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "html2pdf.js": "^0.14.0",
    "i18next": "^24.2.2",
    "pako": "^2.1.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.1.1",
    "recharts": "^3.10.1",
    "sqlite3": "^5.1.7",
    "swr": "^2.5.1",
    "three": "^0.186.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/pako": "^2.0.3",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.186.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.18.0",
    "rimraf": "^6.0.1",
    "sass": "^1.83.4",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3",
    "vite": "^6.0.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.4",
    "wait-on": "^8.0.2"
  }
}
